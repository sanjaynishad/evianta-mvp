# AI provider selection: "googleai" (Gemini Developer API, local dev) or "vertexai" (Cloud Run / prod)
EVIANTA_AI_PROVIDER=googleai

# Gemini Developer API key, used when EVIANTA_AI_PROVIDER=googleai (local dev, free tier)
GEMINI_API_KEY=

# Vertex AI config, used when EVIANTA_AI_PROVIDER=vertexai (production on Cloud Run uses ADC)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# API server port (Cloud Run injects PORT at runtime)
PORT=8080

# Cloud Storage bucket for uploaded document bytes (metadata lives in Firestore)
GCS_BUCKET=

# Path segment for the unlisted usage view, for example a long random string.
# Leave empty to disable the usage view.
EVIANTA_USAGE_VIEW_PATH=

# Local Firebase emulators. `pnpm test:emulators` sets these automatically; set them only when
# pointing a dev server at emulators you started yourself. Leave them unset (not empty) otherwise.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8181
# STORAGE_EMULATOR_HOST=http://127.0.0.1:9199
