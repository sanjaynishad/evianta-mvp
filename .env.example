# AI provider selection: "googleai" (Gemini Developer API, local dev), "vertexai" (Cloud Run / prod),
# or "mock" (scripted outputs for tests and offline runs; needs no key and makes no network calls).
# Model tiers live in packages/ai/src/models.ts: cheap = gemini-2.5-flash-lite, mid = gemini-2.5-flash,
# high = gemini-2.5-pro. Per-tier prices for cost tracking live in packages/ai/src/pricing.ts.
# Google Search grounding is opt-in per call (research agents only). It needs no extra key or setting,
# but Google bills grounded requests separately beyond the free daily allowance.
EVIANTA_AI_PROVIDER=googleai

# Gemini Developer API key, used when EVIANTA_AI_PROVIDER=googleai (local dev, free tier)
GEMINI_API_KEY=

# Vertex AI config, used when EVIANTA_AI_PROVIDER=vertexai (production on Cloud Run uses ADC)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# API server port (Cloud Run injects PORT at runtime)
PORT=8080

# Web app origin(s) allowed by CORS on the API; comma-separate several. Leave empty to send no
# CORS headers (same-origin only).
EVIANTA_WEB_ORIGIN=http://localhost:3000

# Cloud Storage bucket for uploaded document bytes (metadata lives in Firestore)
GCS_BUCKET=

# Path segment for the unlisted usage view, for example a long random string.
# Leave empty to disable the usage view.
EVIANTA_USAGE_VIEW_PATH=

# Local Firebase emulators. `pnpm test:emulators` sets these automatically; set them only when
# pointing a dev server at emulators you started yourself. Leave them unset (not empty) otherwise.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8181
# STORAGE_EMULATOR_HOST=http://127.0.0.1:9199
