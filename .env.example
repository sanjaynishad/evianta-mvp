# AI provider selection: "googleai" (Gemini Developer API, local dev) or "vertexai" (Cloud Run / prod)
EVIANTA_AI_PROVIDER=googleai

# Gemini Developer API key, used when EVIANTA_AI_PROVIDER=googleai (local dev, free tier)
GEMINI_API_KEY=

# Vertex AI config, used when EVIANTA_AI_PROVIDER=vertexai (production on Cloud Run uses ADC)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# API server port (Cloud Run injects PORT at runtime)
PORT=8080
