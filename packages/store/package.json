{
  "name": "@evianta/store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:emulators": "pnpm dlx firebase-tools@13 emulators:exec --only firestore,storage --project demo-evianta \"vitest run emulator\""
  },
  "dependencies": {
    "@evianta/core": "workspace:*",
    "@evianta/env": "workspace:*",
    "@google-cloud/storage": "^7.19.0",
    "firebase-admin": "^13.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@evianta/config": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
