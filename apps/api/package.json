{
  "name": "@evianta/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:emulators": "pnpm dlx firebase-tools@13 emulators:exec --only firestore,storage --project demo-evianta \"vitest run emulator\""
  },
  "dependencies": {
    "@evianta/agents": "workspace:*",
    "@evianta/ai": "workspace:*",
    "@evianta/core": "workspace:*",
    "@evianta/env": "workspace:*",
    "@evianta/ingest": "workspace:*",
    "@evianta/store": "workspace:*",
    "docx": "^9.9.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "multer": "^2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@evianta/config": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/supertest": "^6.0.3",
    "jszip": "^3.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
